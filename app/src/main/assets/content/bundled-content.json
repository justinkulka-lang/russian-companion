    },
    {
      "id": "text-rus-32b9bbf0",
      "stressMarkedText": "катю'ша",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-34196cc9",
