  "sourceTexts": [
    {
      "id": "text-rus-00042ef4",
      "stressMarkedText": "вариа'нт",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-00c922e1",
      "stressMarkedText": "нелегко'",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-013ea3cc",
      "stressMarkedText": "па'лец",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-021a33a4",
      "stressMarkedText": "кровь",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-021b5f9d",
      "stressMarkedText": "интерне'т",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-031f3a76",
      "stressMarkedText": "ужа'сно",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-040e8e43",
      "stressMarkedText": "ли'дер",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-0572e55c",
      "stressMarkedText": "суди'ть",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-0685e112",
      "stressMarkedText": "ку'шать",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-06ec01ad",
      "stressMarkedText": "Ви'ктор",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-099dafa8",
      "stressMarkedText": "футболи'ст",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-0a341994",
      "stressMarkedText": "при",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-0a34cff7",
      "stressMarkedText": "спусти'ть",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-0caf961a",
      "stressMarkedText": "ключ",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-142d4fdf",
      "stressMarkedText": "зима'",
      "sourceRecordId": "shtooka-streit-cc-by-3.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-18146ee7",
      "stressMarkedText": "пе'пельница",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-1a450737",
      "stressMarkedText": "пре'жде",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-1e43428d",
      "stressMarkedText": "бума'га",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-1ef9b054",
      "stressMarkedText": "распространи'ть",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-205ef521",
      "stressMarkedText": "колосса'льный",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-2204c783",
      "stressMarkedText": "перча'тка",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-2383e20d",
      "stressMarkedText": "вы",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-23b64603",
      "stressMarkedText": "лес",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-252a9f95",
      "stressMarkedText": "нехорошо'",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-26a76b8e",
      "stressMarkedText": "журнали'стка",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-2746f35d",
      "stressMarkedText": "не'который",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-27b444bc",
      "stressMarkedText": "запере'ть",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-291dcf07",
      "stressMarkedText": "мы",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-29907959",
      "stressMarkedText": "крем",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-2c7b956d",
      "stressMarkedText": "био'лог",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-2d9b7a7c",
      "stressMarkedText": "Москва'",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-2dacc217",
      "stressMarkedText": "открыва'ть",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-30bc7ddb",
      "stressMarkedText": "глаз",
      "sourceRecordId": "shtooka-streit-cc-by-2.0-fr",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-311037c1",
      "stressMarkedText": "стра'нно",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-316f9a58",
      "stressMarkedText": "бистро'",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-31f54fe8",
      "stressMarkedText": "наи'вный",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-320eeb9b",
      "stressMarkedText": "перспекти'ва",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-326bf667",
      "stressMarkedText": "интересова'ться",
      "sourceRecordId": "shtooka-sakhno-cc-by-3.0-us",
      "modificationStatus": "UNMODIFIED",
      "matchVerified": true
    },
    {
      "id": "text-rus-327f4584",
