      {
        "id": "u3-s-gender",
        "title": "Recognize admitted noun genders",
        "estimatedMinutes": 12,
        "objectiveIds": [
          "obj-u3-gender"
        ],
        "steps": [
          {
            "id": "u3-st-teach-gender-1",
            "kind": "TEACH",
            "title": "Read the admitted grouping sentence",
            "body": "The frozen page says: So, in Russian, nouns have an intrinsic property called 'gender', which comes in three types: masculine, feminine, and neuter. An ending is not a substitute for the admitted record.",
            "referenceIds": [
              "ref-u35-attribution"
            ]
          },
          {
            "id": "u3-st-teach-gender-2",
            "kind": "TEACH",
            "title": "Recorded masculine nouns",
            "body": "These admitted records are listed as masculine. стол — table. дом — house. го́род — town. брат — brother. The admitted record for друг — friend is also masculine. Learn this recorded label; an ending is not a substitute for the record.",
            "referenceIds": [
              "ref-u35-attribution"
            ],
            "exampleIds": [
              "ex-u3-стол",
              "ex-u3-дом",
              "ex-u3-город",
              "ex-u3-брат",
              "ex-u3-друг"
            ]
          },
          {
            "id": "u3-st-guided-gender-2",
            "kind": "GUIDED",
            "title": "Guided practice",
            "body": "Choose the admitted record. The feedback states the frozen field.",
            "itemIds": [
              "u3-i-gender-стол",
              "u3-i-gender-дом"
            ],
            "remediationStepId": "u3-st-rem-gender"
          },
          {
            "id": "u3-st-teach-gender-3",
            "kind": "TEACH",
            "title": "Recorded feminine nouns",
            "body": "These admitted records are listed as feminine. кни́га — book. вода́ — water. шко́ла — school. рабо́та — work. The admitted record for дверь — door is feminine. Learn this recorded label; do not guess the gender of another word from its ending.",
            "referenceIds": [
              "ref-u35-attribution"
            ],
            "exampleIds": [
              "ex-u3-книга",
              "ex-u3-вода",
              "ex-u3-школа",
              "ex-u3-работа",
              "ex-u3-дверь"
            ]
          },
          {
            "id": "u3-st-guided-gender-3",
            "kind": "GUIDED",
            "title": "Guided practice",
            "body": "Choose the admitted record. The feedback states the frozen field.",
            "itemIds": [
              "u3-i-gender-книга"
            ],
            "remediationStepId": "u3-st-rem-gender"
          },
          {
            "id": "u3-st-teach-gender-4",
            "kind": "TEACH",
            "title": "Four records in the third group",
            "body": "These admitted records are listed as neuter. окно́ — window. письмо́ — letter. молоко́ — milk. мо́ре — sea. ",
            "referenceIds": [
              "ref-u35-attribution"
            ],
            "exampleIds": [
              "ex-u3-окно",
              "ex-u3-письмо",
              "ex-u3-молоко",
              "ex-u3-море"
            ]
          },
          {
            "id": "u3-st-guided-gender-4",
            "kind": "GUIDED",
            "title": "Guided practice",
            "body": "Choose the admitted record. The feedback states the frozen field.",
            "itemIds": [
              "u3-i-gender-окно"
            ],
            "remediationStepId": "u3-st-rem-gender"
          },
          {
            "id": "u3-st-teach-gender-5",
            "kind": "TEACH",
            "title": "Two records the page still places in the first group",
            "body": "дя́дя and мужчи́на decline like nouns ending in -а, and they are masculine. Say decline for these nouns. Do not say they conjugate.",
            "referenceIds": [
              "ref-u35-attribution"
            ],
            "exampleIds": [
              "ex-u3-мужчина",
              "ex-u3-дядя"
            ]
          },
          {
            "id": "u3-st-guided-gender-5",
            "kind": "GUIDED",
            "title": "Guided practice",
            "body": "Choose the admitted record. The feedback states the frozen field.",
            "itemIds": [
              "u3-i-gender-мужчина"
            ],
            "remediationStepId": "u3-st-rem-gender"
          },
          {
            "id": "u3-st-rem-gender",
            "kind": "REMEDIATE",
            "title": "Review the admitted noun genders",
            "body": "The frozen page says: So, in Russian, nouns have an intrinsic property called 'gender', which comes in three types: masculine, feminine, and neuter. An ending is not a substitute for the admitted record.\n\nThese admitted records are listed as masculine. стол — table. дом — house. го́род — town. брат — brother. The admitted record for друг — friend is also masculine. Learn this recorded label; an ending is not a substitute for the record.\n\nThese admitted records are listed as feminine. кни́га — book. вода́ — water. шко́ла — school. рабо́та — work. The admitted record for дверь — door is feminine. Learn this recorded label; do not guess the gender of another word from its ending.\n\nThese admitted records are listed as neuter. окно́ — window. письмо́ — letter. молоко́ — milk. мо́ре — sea. \n\nдя́дя and мужчи́на decline like nouns ending in -а, and they are masculine. Say decline for these nouns. Do not say they conjugate.",
            "exampleIds": [
              "ex-u3-стол",
              "ex-u3-дом",
              "ex-u3-город",
              "ex-u3-брат",
              "ex-u3-друг",
              "ex-u3-книга",
              "ex-u3-вода",
              "ex-u3-школа",
              "ex-u3-работа",
              "ex-u3-дверь",
              "ex-u3-окно",
              "ex-u3-письмо",
              "ex-u3-молоко",
              "ex-u3-море",
              "ex-u3-мужчина",
              "ex-u3-дядя"
            ]
          },
          {
            "id": "u3-st-check-gender",
            "kind": "CHECK",
            "title": "Independent checks",
            "body": "These checks use only admitted records. A miss returns to the explanation.",
